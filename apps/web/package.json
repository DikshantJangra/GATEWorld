{
  "name": "gateworld-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "lsof -ti tcp:3000 | xargs kill 2>/dev/null; true",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "dev:vinext": "vite dev --port 3001",
    "build:vinext": "vite build",
    "start:vinext": "vite preview",
    "deploy:vinext": "vinext-cloudflare deploy --warm-cache",
    "deploy:response-store": "cf deploy --prebuilt --mode production --worker gateworld-web-response-store"
  },
  "dependencies": {
    "@cloudflare/workers-response-store": "^1.1.4",
    "@netlify/blobs": "^11.1.7",
    "@vinext/cloudflare": "^1.3.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-icons": "^5.7.0",
    "react-server-dom-webpack": "^19.3.1",
    "vinext": "^1.4.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.v.8",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-rsc": "^0.5.38",
    "cf": "1.0.0-beta.26",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "8.3.0",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.16.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "workerd"
    ]
  },
  "type": "module"
}
